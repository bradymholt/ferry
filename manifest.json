{
  "manifest_version": 3,
  "name": "Ferry",
  "version": "1.0",
  "description": "Moves link-opened tabs out of your pinned-apps window and into your browsing window.",
  "permissions": ["tabs"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
